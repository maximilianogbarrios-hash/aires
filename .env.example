# --- Server ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=cambiar-en-produccion-string-largo-aleatorio

# --- Postgres (Railway lo inyecta automáticamente como DATABASE_URL) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/aires_solo

# --- Usuarios iniciales (cargados a DB en primer arranque si no existen) ---
# ADMIN: acceso total
ADMIN_EMAIL=admin@aires.local
ADMIN_PASSWORD=cambiar123

# SOCIO: acceso total excepto gestión de usuarios
SOCIO_EMAIL=socio@aires.local
SOCIO_PASSWORD=cambiar456

# Hasta 10 usuarios extras vía USER1..USER10. Si no se setean, no se crean.
# USER1_EMAIL=usuario1@aires.local
# USER1_PASSWORD=clave1
# USER1_ROLE=socio
# USER2_EMAIL=...
# USER3_EMAIL=...
# USER4_EMAIL=...

# --- Límites y branding 2FA ---
MAX_USERS=10
TOTP_ISSUER=AiresBurger
